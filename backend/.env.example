# Hermes api_server adapter
HERMES_BASE_URL=http://127.0.0.1:8642
API_SERVER_KEY=
HERMES_SESSION_KEY=athena-local

# Where Hermes reads google_credentials.json / google_token.json from.
# Set exactly one of these. Locally, point HERMES_CONFIG_PATH at your own
# ~/.hermes; for a Hermes box on another machine, run hermes-sidecar/ there and
# set the URL and token instead.
HERMES_CONFIG_PATH=
HERMES_FILES_URL=
HERMES_FILES_TOKEN=

# Bearer token Hermes must send to call Athena's MCP tool server at /mcp.
# Must match mcp_servers.athena.headers.Authorization in Hermes' own
# ~/.hermes/config.yaml. Leave empty to keep /mcp disabled (503).
MCP_TOKEN=

# Shared secret POST /materials/gather/run must receive as X-Gather-Token.
# Set by whatever hits that endpoint -- a cron job, and the frontend's "Sync
# now" button (see frontend's MATERIALS_GATHER_TOKEN). Leave empty to keep the
# endpoint refusing every request; it auto-imports and ingests, so it must not
# be reachable by accident.
MATERIALS_GATHER_TOKEN=

# Dev-only: shows the "Reset all materials" button on the Materials page and
# enables POST /materials/gather/reset, which wipes every source file, topic,
# chunk, embedding and gather-run record. NEVER set this to true outside a
# local/dev environment -- it is not gated by anything else.
TEST_MODE=false

# Encrypts stored OAuth credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, connecting Google is refused rather than stored in plaintext.
CONNECTIONS_SECRET_KEY=

# Google OAuth. The client id/secret are uploaded by the user in Settings, not
# set here -- these only shape the consent request.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email
GOOGLE_LOOPBACK_PORT=9004

# Frontend origin allowed through CORS
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
