# Hermes api_server adapter
HERMES_BASE_URL=http://127.0.0.1:8642
API_SERVER_KEY=
HERMES_SESSION_KEY=athena-local

# Where Hermes reads google_credentials.json / google_token.json from.
# Set exactly one of these. Locally, point HERMES_CONFIG_PATH at your own
# ~/.hermes; for a Hermes box on another machine, run hermes-sidecar/ there and
# set the URL and token instead.
HERMES_CONFIG_PATH=
HERMES_FILES_URL=
HERMES_FILES_TOKEN=

# Encrypts stored OAuth credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, connecting Google is refused rather than stored in plaintext.
CONNECTIONS_SECRET_KEY=

# Google OAuth. The client id/secret are uploaded by the user in Settings, not
# set here -- these only shape the consent request.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email
GOOGLE_LOOPBACK_PORT=9004

# Frontend origin allowed through CORS
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
