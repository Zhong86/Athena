# VPS deploy config. Copy to `.env` next to docker-compose.yml on the server
# and fill in. This file is read by both compose itself and the backend
# container -- it is NOT the same as backend/.env, which stays local-only.

# The domain Caddy will request a certificate for. Its A record must already
# point at this VPS or the TLS handshake will fail on first boot.
#
# No domain yet? nip.io resolves <ip-with-dashes>.nip.io to that IP for free,
# with no signup or DNS record needed -- Let's Encrypt treats it as a real
# hostname and issues a normal cert. Swap in a real domain later; nothing else
# in this file needs to change when you do.
ATHENA_DOMAIN=103-30-146-148.nip.io

# Basic-auth guard on /api/connections* -- the one route that takes a Google
# OAuth client secret, on a system with no login of its own. Pick a username,
# then generate the hash on the VPS (not here -- it's specific to the caddy
# image's bcrypt implementation):
# Use a plain `docker run`, not `docker compose run` -- compose refuses to read
# this file at all while the two values below are still empty:
#   docker run --rm caddy:2-alpine caddy hash-password
#
# The hash starts with $2a$ or $2b$ -- compose treats unescaped $ in .env as
# variable interpolation and silently truncates everything after it. Double
# every $ to $$ when you paste the hash in here, e.g. $2a$14$abc -> $$2a$$14$$abc.
ATHENA_ADMIN_USER=
ATHENA_ADMIN_PASSWORD_HASH=

# GHCR namespace the CI workflow pushes to (your GitHub username, lowercased).
GITHUB_REPOSITORY_OWNER=zhong86
# Pin to a commit SHA to roll back; `latest` tracks main.
IMAGE_TAG=latest

# --- Backend ---------------------------------------------------------------

# Must be reachable from inside the container. 127.0.0.1 here would mean the
# container itself, not the host -- docker-compose.yml maps host.docker.internal
# to the host for this reason. If Hermes listens on its default 8642, this is
# almost always the right value as-is.
HERMES_BASE_URL=http://host.docker.internal:8642
API_SERVER_KEY=
HERMES_SESSION_KEY=athena-prod

# Hermes credential files. On this VPS Hermes runs on the host, so compose
# bind-mounts its config directory into the backend container and the backend
# writes the files directly -- the credentials never cross a network.
#
# HERMES_CONFIG_DIR is the path on the *host*; HERMES_CONFIG_PATH is where that
# lands inside the container and is set by docker-compose.yml, not here.
HERMES_CONFIG_DIR=/root/.hermes

# Only for a Hermes box on another machine (debugging). Leave empty in
# production -- setting both these and the bind mount is a configuration error.
HERMES_FILES_URL=
HERMES_FILES_TOKEN=

# Encrypts stored OAuth credentials at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes every stored credential undecryptable -- the user
# would have to reconnect Google.
CONNECTIONS_SECRET_KEY=

# Google OAuth. The client id/secret are uploaded by the user in Settings, not
# set here -- these only shape the consent request.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email
GOOGLE_LOOPBACK_PORT=9004

# CORS. Same-origin in this setup, but the backend still checks it.
FRONTEND_ORIGIN=https://103-30-146-148.nip.io

# Shared secret POST /materials/gather/run requires as X-Gather-Token. Both the
# backend (via env_file below) and the frontend (via docker-compose.yml's
# explicit environment: block -- the frontend service has no env_file of its
# own) need the same value: the cron job that triggers a scheduled sync and
# the "Sync now" button both send it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MATERIALS_GATHER_TOKEN=

# Leave unset. TEST_MODE=true enables a bulk-delete endpoint and a visible
# "Reset all materials" button meant only for local development -- it is not
# gated by ATHENA_ADMIN_USER/PASSWORD or anything else on this VPS. Setting
# it here would expose it to the internet.
TEST_MODE=
